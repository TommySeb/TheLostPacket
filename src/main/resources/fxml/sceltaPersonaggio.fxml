<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            prefWidth="600.0"
            prefHeight="400.0"
            style="-fx-background-color: black;">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <top>
        <Label  text="Scegli il tuo personaggio"
                style=" -fx-font-size: 30px;
                        -fx-font-weight: bold;
                        -fx-text-fill: white"/>
    </top>
    
    <center>
        <HBox>
            <VBox alignment="TOP_CENTER">
                <Button style="-fx-background-color: black;">
                    <graphic>
                        <ImageView fitWidth="400" fitHeight="400">
                            <Image url="@/personaggi/alleati/masterizzatore.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Label text="Masterizzatore di CD/DVD"
                        style=" -fx-font-size: 20px;
                                -fx-text-fill: white"/>
            </VBox>

            <VBox alignment="TOP_CENTER">
                <Button style="-fx-background-color: black;">
                    <graphic>
                        <ImageView fitWidth="400" fitHeight="400">
                            <Image url="@/personaggi/alleati/sistemistaRete.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Label text="Sistemista di rete"
                        style=" -fx-font-size: 20px;
                                -fx-text-fill: white"/>
            </VBox>

            <VBox alignment="TOP_CENTER">
                <Button style="-fx-background-color: black;">
                    <graphic>
                        <ImageView fitWidth="400" fitHeight="400">
                            <Image url="@/personaggi/alleati/snifferRete.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Label text="Sniffer di rete"
                       style=" -fx-font-size: 20px;
                                -fx-text-fill: white"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.unicam.cs.mpgc.rpg130577.controller.SceltaPersonaggioController"
            stylesheets="@/css/sceltaPersonaggio.css">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <top>
        <Label fx:id="titolo" text="Scegli il tuo personaggio"/>
    </top>
    
    <center>
        <HBox>
            <VBox alignment="TOP_CENTER">
                <Button onAction="#scegliMasterizzatore">
                    <graphic>
                        <ImageView>
                            <Image url="@/personaggi/alleati/masterizzatore.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Label text="Masterizzatore di CD/DVD"/>
            </VBox>

            <VBox alignment="TOP_CENTER">
                <Button onAction="#scegliSistemista">
                    <graphic>
                        <ImageView>
                            <Image url="@/personaggi/alleati/sistemistaRete.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Label text="Sistemista di rete"/>
            </VBox>

            <VBox alignment="TOP_CENTER">
                <Button onAction="#scegliSniffer">
                    <graphic>
                        <ImageView>
                            <Image url="@/personaggi/alleati/snifferRete.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Label text="Sniffer di rete"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="layout"
            fx:controller="it.unicam.cs.mpgc.rpg130577.controller.GiocoController"
            stylesheets="@../css/gioco.css">

    <left>
        <VBox prefWidth="150.0">
            <ImageView fx:id="immagineAlleato"/>

            <HBox>
                <Label fx:id="hpAttualiAlleato"/>
                <Label text=" HP / "/>
                <Label fx:id="hpMassimiAlleato"/>
                <Label text=" HP"/>
            </HBox>

            <Separator/>

            <Label fx:id="attacchiDisponibiliAlleato"/>
        </VBox>

    </left>

    <right>
        <VBox>
            <ImageView fx:id="immagineAvversario"/>

            <HBox>
                <Label fx:id="hpAttualiAvversario"/>
                <Label text=" HP / "/>
                <Label fx:id="hpMassimiAvversario"/>
                <Label text=" HP"/>
            </HBox>

            <Separator/>

            <Label fx:id="attacchiDisponibiliAvversario"/>
        </VBox>
    </right>

</BorderPane>
